# ==============================================================================
# 1. Variáveis PÚBLICAS do Frontend (incluídas no bundle JS do navegador)
#    NUNCA coloque chaves secretas (TMDB, MDBList, OMDb) com prefixo VITE_.
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: deixe vazio na web para usar rotas relativas (/api/tmdb, /api/ratings, /api/imdb).
# Ao gerar o build do Capacitor Android, preencha com a URL final do Cloudflare Pages:
# Ex.: VITE_API_BASE_URL=https://seu-projeto.pages.dev
VITE_API_BASE_URL=

# ==============================================================================
# 2. Segredos do Backend / Cloudflare Pages Functions (SEM prefixo VITE_)
#    Em produção: cadastre no painel do Cloudflare Pages em:
#      Settings > Environment variables (Production / Preview).
#    Em desenvolvimento local: preencha no arquivo .env (nunca commitado) para
#      o dev server do Vite fazer o proxy de /api/* localmente.
# ==============================================================================
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
MDBLIST_API_KEY=
OMDB_API_KEY=